<Window x:Class="PharmaControlWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоматизация контроля фармакотерапии" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с ролью и переключением -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnSwitchRole" Content="🔄 Сменить роль" Width="150" Height="35" 
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                        Click="BtnSwitchRole_Click" Margin="0,0,20,0"/>
                <TextBlock x:Name="lblRole" Text="Роль: Врач" FontSize="16" FontWeight="Bold" 
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое (TabControl с двумя вкладками) -->
        <TabControl x:Name="tabControlMain" Grid.Row="1" Margin="0,0,0,10">

            <!-- ========== ВКЛАДКА ВРАЧА ========== -->
            <TabItem x:Name="tabDoctor" Header="👨‍⚕️ Врач">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: список пациентов -->
                    <Border Grid.Column="0" Background="#F5F5F5" Padding="10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="📋 Пациенты" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox x:Name="listBoxPatients" Height="500" 
                                     SelectionChanged="ListBoxPatients_SelectionChanged"
                                     DisplayMemberPath="FullName"/>
                        </StackPanel>
                    </Border>

                    <!-- Центральная колонка: назначения -->
                    <Border Grid.Column="1" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="10,0">
                        <StackPanel>
                            <TextBlock Text="💊 Активные назначения" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <DataGrid x:Name="dataGridActivePrescriptions" AutoGenerateColumns="True" 
                                      Height="200" Margin="0,0,0,20" IsReadOnly="True"/>

                            <TextBlock Text="📜 История завершенных курсов" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox x:Name="listBoxHistory" Height="200" DisplayMemberPath="DrugName"/>
                        </StackPanel>
                    </Border>

                    <!-- Правая колонка: действия врача -->
                    <Border Grid.Column="2" Background="#F5F5F5" Padding="10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="⚡ Действия" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                            <Button x:Name="btnCheckCompatibility" Content="🔍 Проверить совместимость" 
                                    Height="40" Margin="0,0,0,10" Click="BtnCheckCompatibility_Click"/>

                            <Button x:Name="btnCheckAllergy" Content="⚠️ Проверить аллергию" 
                                    Height="40" Margin="0,0,0,10" Click="BtnCheckAllergy_Click"/>

                            <Button x:Name="btnAddPrescription" Content="➕ Добавить препарат" 
                                    Height="40" Margin="0,0,0,10" Click="BtnAddPrescription_Click"/>

                            <Button x:Name="btnDeleteDrug" Content="❌ Удалить препарат" 
                                    Height="40" Margin="0,0,0,10" Click="BtnDeleteDrug_Click"/>

                            <Button x:Name="btnAddInteraction" Content="🔄 Добавить взаимодействие" 
                                    Height="40" Margin="0,0,0,10" Click="BtnAddInteraction_Click"/>

                            <Button x:Name="btnLowComplianceReport" Content="📊 Низкая приверженность" 
                                    Height="40" Margin="0,0,0,10" Click="BtnLowComplianceReport_Click"/>

                            <Button x:Name="btnExportReport" Content="📁 Выгрузить отчет" 
                                    Height="40" Margin="0,0,0,10" Click="BtnExportReport_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== ВКЛАДКА ПАЦИЕНТА ========== -->
            <TabItem x:Name="tabPatient" Header="🧑‍⚕️ Пациент">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Информация о пациенте -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#2C3E50" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                        <TextBlock x:Name="lblPatientName" Text="Пациент: " FontSize="16" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Левая колонка: расписание и курсы -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="📅 Расписание на сегодня" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox x:Name="listBoxSchedule" Height="150" Margin="0,0,0,20"/>

                            <TextBlock Text="✅ Завершенные курсы" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox x:Name="listBoxCompletedCourses" Height="150" Margin="0,0,0,20"/>

                            <TextBlock Text="📋 Инструкция к препарату" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtInstruction" Height="100" TextWrapping="Wrap" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <!-- Правая колонка: отметки и архив -->
                    <Border Grid.Row="1" Grid.Column="1" Background="#F5F5F5" Padding="10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="💊 Отметка о приеме" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Button x:Name="btnMarkTaken" Content="✅ Принял" Width="120" Height="40" 
                                        Margin="0,0,10,0" Click="BtnMarkTaken_Click"/>
                                <Button x:Name="btnMarkMissed" Content="❌ Пропустил" Width="120" Height="40" 
                                        Click="BtnMarkMissed_Click"/>
                            </StackPanel>

                            <Button x:Name="btnShowDrugInfo" Content="ℹ️ Показать инструкцию" Width="150" Height="35"
                                    Margin="0,0,0,15" Click="BtnShowDrugInfo_Click"/>

                            <TextBlock Text="📜 Архив отметок о приеме" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <DataGrid x:Name="dataGridMarks" AutoGenerateColumns="True" Height="250" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя панель статуса -->
        <StatusBar Grid.Row="2" Background="#34495E" Padding="5">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Foreground="White" Text="Готов к работе"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
